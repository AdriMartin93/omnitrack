<?xml version="1.0" encoding="UTF-8"?>
<!-- CORREGIDO: Único bloque de propiedades fusionado sin etiquetas duplicadas -->
<project xmlns="http://apache.org">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.0</version>
        <relativePath/>
    </parent>

    <groupId>com.omnitrak</groupId>
    <artifactId>omnitrak-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2024.0.0</spring-cloud.version>
        <lombok.version>1.18.36</lombok.version>
    </properties>

    <modules>
        <module>user-service</module>
        <module>service-registry</module>
        <module>api-gateway</module>
        <module>config-server</module>
        <module>catalog-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Versiones globales para componentes de Spring Cloud -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Versión global para forzar Lombok compatible con Java 21 -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
